10. DATA FORMATS
================================================================================

10.1 Metadata JSON
------------------

File: data/processed/shinagawa/metadata.json

Example:

{
  "schema_version": 1,
  "area_name": "Tokyo Shinagawa PoC",
  "created_at": "2026-07-02T00:00:00+09:00",
  "bbox": {
    "north": 35.6420,
    "south": 35.6150,
    "east": 139.7600,
    "west": 139.7150
  },
  "projection": {
    "source_epsg": 4326,
    "target_epsg": 32654,
    "origin_easting": 123456.0,
    "origin_northing": 456789.0
  },
  "counts": {
    "road_segments": 0,
    "road_vertices": 0,
    "road_triangles": 0,
    "buildings": 0,
    "building_vertices": 0,
    "building_triangles": 0,
    "skipped_buildings": 0
